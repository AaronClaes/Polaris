# Google OAuth client (for the Calendar / Workspace integration).
#
# Create one at https://console.cloud.google.com →
#   APIs & Services → Enable "Google Calendar API"
#   APIs & Services → Credentials → Create credentials → OAuth client ID
#   Application type: "Desktop app"
# then copy the client ID + secret below into a local, gitignored `.env`.
#
# The "secret" isn't truly confidential for a desktop app — security comes from
# PKCE — but we still keep it out of git. electron-vite exposes MAIN_VITE_*
# vars to the main process as `import.meta.env.MAIN_VITE_*`.
MAIN_VITE_GOOGLE_CLIENT_ID=
MAIN_VITE_GOOGLE_CLIENT_SECRET=
